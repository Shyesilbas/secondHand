# Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/secondhand
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# Required in prod (ProdSecurityGuard); empty means no AUTH for local Docker Redis.
REDIS_PASSWORD=

# Security / JWT
JWT_SECRET_KEY=your_very_secret_key_here_min_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_SCOPE=email,profile
REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
ISSUER_URI=https://accounts.google.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI / Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_FALLBACK_MEMORY_MODEL=gemini-2.0-flash-lite
GEMINI_DAILY_GLOBAL_LIMIT=250
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MEMORY_MAX_OUTPUT_TOKENS=512
AI_SUMMARY_IP_HOURLY_LIMIT=10
AI_SUMMARY_NEGATIVE_CACHE_SECONDS=120

# Exchange API
EXCHANGE_API_KEY=your_exchange_api_key

# App Configuration
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (Pencere bazlı istek limitleri, varsayılan pencere: 60 sn)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_GENERAL=150
RATE_LIMIT_AI=15
RATE_LIMIT_WINDOW=60
